{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"Stop": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/stop-hook-git-check.sh"
					}
				]
			}
		]
	},
	"permissions": {
		"allow": [
			"Bash(pnpm *)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git add:*)",
			"Bash(git commit:*)",
			"Bash(git log:*)",
			"Bash(git push: *)"
		],
		"deny": ["Bash(rm -rf:*)"]
	}
}
