{
  "expo": {
    "name": "kharcha",
    "slug": "kharcha",
    "scheme": "kharcha",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chetanjain.kharcha",
      "deploymentTarget": "17.0",
      "buildNumber": "1",
      "icon": "./assets/icon.png",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0a0a0a"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.chetanjain.kharcha"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "versionCode": 2,
      "permissions": [],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "kharcha" }],
          "category": ["DEFAULT", "BROWSABLE"]
        }
      ],
      "package": "com.chetanjain.kharcha"
    },
    "updates": {
      "url": "https://u.expo.dev/a5f4eef2-324f-4113-833a-08722062b934"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-updates",
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-quick-actions",
      "expo-secure-store",
      "expo-web-browser",
      ["react-native-widget-extension", {
        "groupIdentifier": "group.com.chetanjain.kharcha",
        "deploymentTarget": "17.0"
      }],
      ["react-native-android-widget", {
        "widgets": [
          {
            "name": "KharchaSmallWidget",
            "label": "Kharcha Spending",
            "description": "See your monthly spending at a glance.",
            "minWidth": "110dp",
            "minHeight": "110dp",
            "targetCellWidth": 2,
            "targetCellHeight": 2,
            "resizeMode": "none"
          },
          {
            "name": "KharchaMediumWidget",
            "label": "Kharcha Spending",
            "description": "Monthly spending with top categories.",
            "minWidth": "250dp",
            "minHeight": "110dp",
            "targetCellWidth": 4,
            "targetCellHeight": 2,
            "resizeMode": "horizontal"
          }
        ]
      }]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a5f4eef2-324f-4113-833a-08722062b934"
      }
    },
    "owner": "jainchetan81"
  }
}
