{
	"name": "kharcha",
	"version": "0.7.2",
	"main": "./index.js",
	"engines": {
		"node": ">=22.19.0",
		"pnpm": ">=9.0.0"
	},
	"packageManager": "pnpm@9.0.0",
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"android:device": "expo run:android --device --variant release",
		"ios": "expo run:ios",
		"ios:device": "expo run:ios --device --configuration Release",
		"ios:clean": "rm -rf ios && expo prebuild --platform ios --clean && cd ios && pod install && cd ..",
		"android:clean": "rm -rf android && expo prebuild --platform android --clean",
		"clean:all": "rm -rf ios android && expo prebuild --clean && cd ios && pod install && cd ..",
		"web": "expo start --web",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"quality": "pnpm lint && pnpm typecheck",
		"local-ci": "pnpm install --frozen-lockfile && pnpm quality && pnpm audit --audit-level=high || true && pnpm dead-code",
		"doctor": "expo-doctor",
		"expo-dependency-check": "pnpm dlx expo install --check",
		"dead-code": "knip --no-exit-code",
		"drizzle:generate": "drizzle-kit generate",
		"drizzle:studio": "drizzle-kit studio",
		"build:android": "eas build --platform android --profile production",
		"build:android:preview": "eas build --platform android --profile preview",
		"build:android:local": "eas build --platform android --profile production --local",
		"submit:android": "eas submit --platform android",
		"update:production": "eas update --branch production --auto",
		"update:preview": "eas update --branch preview --auto"
	},
	"dependencies": {
		"@expo-google-fonts/geist": "^0.4.1",
		"@expo-google-fonts/geist-mono": "^0.4.1",
		"@react-native-community/datetimepicker": "8.6.0",
		"@react-native-firebase/analytics": "^24.0.0",
		"@react-native-firebase/app": "^24.0.0",
		"@react-native-firebase/crashlytics": "^24.0.0",
		"@react-native-firebase/perf": "^24.0.0",
		"@react-native-google-signin/google-signin": "^16.1.2",
		"@rn-primitives/slot": "^1.2.0",
		"@shopify/flash-list": "2.0.2",
		"@tanstack/react-form": "^1.28.5",
		"@tanstack/react-query": "^5.95.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"drizzle-orm": "^0.45.2",
		"expo": "~55.0.9",
		"expo-application": "~55.0.10",
		"expo-auth-session": "~55.0.10",
		"expo-clipboard": "^55.0.11",
		"expo-constants": "~55.0.9",
		"expo-device": "~55.0.10",
		"expo-document-picker": "^55.0.13",
		"expo-file-system": "^55.0.16",
		"expo-font": "^55.0.6",
		"expo-haptics": "~55.0.12",
		"expo-linear-gradient": "^55.0.11",
		"expo-linking": "~55.0.9",
		"expo-local-authentication": "~55.0.13",
		"expo-modules-core": "^55.0.23",
		"expo-quick-actions": "^6.0.1",
		"expo-router": "~55.0.8",
		"expo-secure-store": "~55.0.9",
		"expo-share-intent": "^6.1.0",
		"expo-sharing": "^55.0.18",
		"expo-sqlite": "~55.0.11",
		"expo-status-bar": "~55.0.4",
		"expo-system-ui": "^55.0.11",
		"expo-updates": "^55.0.16",
		"expo-web-browser": "~55.0.10",
		"fuse.js": "^7.0.0",
		"lucide-react-native": "^1.7.0",
		"nativewind": "^4.2.3",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"react-native": "0.83.4",
		"react-native-android-widget": "^0.20.1",
		"react-native-gesture-handler": "~2.30.0",
		"react-native-gifted-charts": "^1.4.76",
		"react-native-network-logger": "^2.0.1",
		"react-native-reanimated": "^4.2.1",
		"react-native-safe-area-context": "~5.6.2",
		"react-native-screens": "^4.23.0",
		"react-native-svg": "^15.15.3",
		"react-native-toast-message": "^2.3.3",
		"react-native-widget-extension": "^0.2.0",
		"react-native-worklets": "0.8.1",
		"sms-notification-listener": "file:./modules/sms-notification-listener",
		"tailwind-merge": "^3.5.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"@dev-plugins/react-query": "^0.4.0",
		"@types/react": "~19.2.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"drizzle-kit": "^0.31.10",
		"expo-doctor": "1.18.15-canary-20260328-2049187",
		"knip": "^6.2.0",
		"lefthook": "^2.1.4",
		"tailwindcss": "^3.4.19",
		"typescript": "~5.9.2"
	},
	"private": true,
	"pnpm": {
		"overrides": {
			"@expo/log-box": "55.0.8"
		}
	}
}
